---
const faqs = [
  {
    q: 'What kind of leather is used?',
    a: 'We work exclusively with real Italian cow hide leather, selected for its grain quality, durability, and natural character — designed to age beautifully and last for years.',
  },
  {
    q: 'When will I receive my order?',
    a: 'Orders placed before 2:00 PM are packaged and shipped the same day, delivered next day. Orders placed after 2:00 PM arrive within 2 days. Flat 10 AED shipping across the UAE.',
  },
  {
    q: 'Where are the products made?',
    a: 'Every piece is designed and handmade in Dubai by the founder herself — using premium top-grain Italian leather and the same techniques passed down from her uncle, a craftsman who worked with an Italian luxury fashion house.',
  },
  {
    q: 'What is the return policy?',
    a: 'Returns are accepted within 10 days of delivery. Items must be unused, in original condition, and in original packaging.',
  },
  {
    q: 'Do you work with corporate clients?',
    a: 'Yes — we work with corporate and private clients for bespoke pieces, gifting, and branded accessories. Reach out via WhatsApp or email to discuss your requirements.',
  },
];
---
<section class="bg-void-2 py-28 px-6 sm:px-12 lg:px-16 xl:px-24">
  <div class="max-w-7xl mx-auto">

    <div class="grid lg:grid-cols-[1fr_2fr] gap-16 xl:gap-32">

      <div>
        <div class="flex items-center gap-3 mb-6">
          <div class="h-px w-6 bg-caramel"></div>
          <p class="text-caramel text-[11px] tracking-[0.25em] uppercase">Questions</p>
        </div>
        <h2 class="font-serif text-4xl sm:text-5xl text-white leading-tight">
          Common<br /><em class="text-caramel">questions.</em>
        </h2>
        <p class="mt-6 text-sand/40 text-sm leading-relaxed">
          Anything else? Message us on WhatsApp — we reply within the hour.
        </p>
        <a
          href="https://wa.me/971523244717"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 inline-flex items-center gap-2 text-[11px] tracking-[0.18em] uppercase text-caramel hover:text-caramel-light transition-colors"
        >
          WhatsApp us →
        </a>
      </div>

      <div class="divide-y divide-white/6" id="faq-list">
        {faqs.map((faq, i) => (
          <div class="faq-item py-7" data-index={i}>
            <button
              class="faq-btn w-full flex items-center justify-between gap-8 text-white text-sm tracking-wide font-light text-left"
              aria-expanded="false"
            >
              <span>{faq.q}</span>
              <span class="faq-icon shrink-0 text-caramel text-xl leading-none transition-transform duration-300">+</span>
            </button>
            <div class="faq-body overflow-hidden" style="max-height: 0;">
              <p class="pt-5 pb-2 text-sand/45 text-sm leading-relaxed font-light pr-8">{faq.a}</p>
            </div>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.faq-item').forEach(item => {
    const btn = item.querySelector<HTMLButtonElement>('.faq-btn')!;
    const body = item.querySelector<HTMLElement>('.faq-body')!;
    const icon = item.querySelector<HTMLElement>('.faq-icon')!;

    btn.addEventListener('click', () => {
      const isOpen = btn.getAttribute('aria-expanded') === 'true';

      // Close all
      document.querySelectorAll<HTMLElement>('.faq-item').forEach(other => {
        other.querySelector('.faq-btn')!.setAttribute('aria-expanded', 'false');
        (other.querySelector('.faq-body') as HTMLElement).style.maxHeight = '0';
        (other.querySelector('.faq-icon') as HTMLElement).style.transform = 'rotate(0deg)';
      });

      // Open this one if it was closed
      if (!isOpen) {
        btn.setAttribute('aria-expanded', 'true');
        body.style.maxHeight = body.scrollHeight + 'px';
        icon.style.transform = 'rotate(45deg)';
      }
    });
  });
</script>

<style>
  .faq-body {
    transition: max-height 0.4s ease-in-out;
  }
  #faq-list {
    overflow-anchor: none;
  }
</style>
