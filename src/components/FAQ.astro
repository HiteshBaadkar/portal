---
const faqs = [
  {
    q: 'What kind of leather is used?',
    a: 'We work exclusively with real Italian cow hide leather, selected for its grain quality, durability, and natural character — designed to age beautifully and last for years.',
  },
  {
    q: 'When will I receive my order?',
    a: 'Orders placed before 2:00 PM are packaged and shipped the same day, delivered next day. Orders placed after 2:00 PM arrive within 2 days. Flat 10 AED shipping across the UAE.',
  },
  {
    q: 'Where are the products made?',
    a: 'Every piece is designed and handmade in Dubai by the founder herself — using premium top-grain Italian leather and the same techniques passed down from her uncle, a craftsman who worked with an Italian luxury fashion house.',
  },
  {
    q: 'What is the return policy?',
    a: 'Returns are accepted within 10 days of delivery. Items must be unused, in original condition, and in original packaging.',
  },
  {
    q: 'Do you work with corporate clients?',
    a: 'Yes — we work with corporate and private clients for bespoke pieces, gifting, and branded accessories. Reach out via WhatsApp or email to discuss your requirements.',
  },
];
---
<section class="bg-void-2 py-28 px-6 sm:px-12 lg:px-16 xl:px-24">
  <div class="max-w-7xl mx-auto">

    <div class="flex items-center gap-3 mb-14">
      <div class="h-px w-6 bg-caramel"></div>
      <p class="text-caramel text-xs tracking-[0.25em] uppercase">Questions</p>
    </div>

    <div class="grid lg:grid-cols-2 gap-0 border border-white/6">

      <!-- Question list -->
      <div class="border-r border-white/6">
        {faqs.map((faq, i) => (
          <button
            class="faq-q w-full text-left px-8 py-6 border-b border-white/6 last:border-b-0 flex items-center justify-between gap-6 transition-colors duration-200 hover:bg-white/3 group"
            data-index={String(i)}
            aria-selected={i === 0 ? 'true' : 'false'}
          >
            <span class="text-base font-light tracking-wide text-sand/50 group-[&[aria-selected=true]]:text-white transition-colors duration-200">{faq.q}</span>
            <span class="shrink-0 w-1.5 h-1.5 rounded-full bg-caramel opacity-0 group-[&[aria-selected=true]]:opacity-100 transition-opacity duration-200"></span>
          </button>
        ))}
      </div>

      <!-- Answer panel — fixed height, content fades -->
      <div class="relative min-h-[280px] flex flex-col justify-between p-8 lg:p-12">
        {faqs.map((faq, i) => (
          <div
            class="faq-a absolute inset-0 p-8 lg:p-12 flex flex-col justify-between transition-opacity duration-300"
            data-index={String(i)}
            aria-hidden={i !== 0 ? 'true' : 'false'}
            style={i !== 0 ? 'opacity:0;pointer-events:none' : ''}
          >
            <p class="text-sand/55 text-base leading-relaxed font-light">{faq.a}</p>
            <a
              href="https://wa.me/971523244717"
              target="_blank"
              rel="noopener noreferrer"
              class="mt-8 inline-flex items-center gap-2 text-[11px] tracking-[0.18em] uppercase text-caramel hover:text-caramel-light transition-colors self-start"
            >
              Ask us on WhatsApp →
            </a>
          </div>
        ))}
      </div>

    </div>

  </div>
</section>

<script>
  const questions = document.querySelectorAll<HTMLButtonElement>('.faq-q');
  const answers   = document.querySelectorAll<HTMLElement>('.faq-a');

  questions.forEach(btn => {
    btn.addEventListener('click', () => {
      const idx = btn.dataset.index!;

      questions.forEach(q => q.setAttribute('aria-selected', 'false'));
      btn.setAttribute('aria-selected', 'true');

      answers.forEach(a => {
        const active = a.dataset.index === idx;
        a.style.opacity = active ? '1' : '0';
        a.style.pointerEvents = active ? 'auto' : 'none';
        a.setAttribute('aria-hidden', active ? 'false' : 'true');
      });
    });
  });
</script>
