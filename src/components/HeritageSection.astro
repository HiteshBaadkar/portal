---
---
<section id="atelier" class="bg-void py-28 px-6 sm:px-12 lg:px-16 xl:px-24">
  <div class="max-w-7xl mx-auto">

    <!-- Top label -->
    <div class="flex items-center gap-3 mb-20">
      <div class="h-px w-6 bg-caramel"></div>
      <p class="text-caramel text-[11px] tracking-[0.25em] uppercase">The Atelier</p>
    </div>

    <!-- Main grid -->
    <div class="grid lg:grid-cols-2 gap-16 xl:gap-32 items-start">

      <!-- Images -->
      <div class="grid grid-cols-2 gap-3">
        <div class="col-span-2 overflow-hidden aspect-[16/9]">
          <img
            src="https://turfaa-atelier.com/cdn/shop/files/image0_f3b77d30-6e56-4006-9e56-7b29bbf2cef2.jpg?height=800&v=1778485171"
            alt="Turfaa Atelier leather workshop"
            class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
            loading="lazy"
          />
        </div>
        <div class="overflow-hidden aspect-square">
          <img
            src="https://turfaa-atelier.com/cdn/shop/files/ChatGPTImageMay11_2026at10_25_27AM.png?height=540&v=1778482073"
            alt="Hand-cutting leather"
            class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
            loading="lazy"
          />
        </div>
        <div class="overflow-hidden aspect-square">
          <img
            src="https://turfaa-atelier.com/cdn/shop/files/ChatGPT_Image_May_12_2026_at_09_53_40_AM_c87d3e6c-c298-4a17-b068-97c40810d238.png?v=1778565686&width=600"
            alt="Edge finishing leather"
            class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
            loading="lazy"
          />
        </div>
      </div>

      <!-- Copy -->
      <div id="craftsmanship" class="lg:pt-4">
        <h2 class="font-serif text-4xl sm:text-5xl text-white leading-tight mb-10">
          Every piece begins<br />
          <em class="text-caramel">here, in Dubai.</em>
        </h2>

        <div class="space-y-6 text-sand/50 text-base leading-relaxed font-light">
          <p>
            Every Turfaa piece begins in our Dubai atelier, where leather is carefully selected, hand-cut, edge-finished, and assembled in small batches. This is where design meets craftsmanship.
          </p>
          <p>
            Craftsmanship is at the heart of Turfaa Atelier. Every piece is handmade by the founder herself, whose passion for leather craft began years ago as a hobby. She learned from her uncle — a skilled craftsman who worked with an Italian luxury fashion house.
          </p>
          <p>
            We use only 100% Italian cow leather, chosen for its grain quality and natural character. Built to last for years, growing richer with time.
          </p>
        </div>

        <!-- Stats -->
        <div class="mt-12 grid grid-cols-2 gap-6 border-t border-white/8 pt-10">
          {[
            { label: 'Origin', value: 'Italian Cow Leather' },
            { label: 'Made in', value: 'Dubai, UAE' },
            { label: 'Method', value: 'Hand-cut & assembled' },
            { label: 'Production', value: 'Small batches only' },
          ].map(item => (
            <div>
              <p class="text-[10px] tracking-[0.2em] uppercase text-sand/25 mb-2">{item.label}</p>
              <p class="text-sand/70 text-sm font-light">{item.value}</p>
            </div>
          ))}
        </div>

        <a
          href="https://instagram.com/turfaa.atelier"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-10 inline-flex items-center gap-3 text-[11px] tracking-[0.18em] uppercase text-caramel hover:text-caramel-light transition-colors"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
          Follow @turfaa.atelier
        </a>
      </div>

    </div>
  </div>
</section>
