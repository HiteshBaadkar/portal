---
---
<section class="relative min-h-screen flex items-end overflow-hidden">

  <div class="absolute inset-0">
    <img
      src="/images/hero.jpg"
      alt=""
      aria-hidden="true"
      class="w-full h-full object-cover"
      loading="eager"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-void via-void/60 to-void/20"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-void/70 via-transparent to-transparent"></div>
  </div>

  <div class="relative z-10 w-full max-w-7xl mx-auto px-6 sm:px-12 lg:px-16 xl:px-24 pb-20 lg:pb-28 pt-32">
    <div class="max-w-2xl">

      <div class="flex items-center gap-3 mb-8 hero-eyebrow">
        <div class="h-px w-8 bg-caramel anim-line"></div>
        <p class="text-caramel text-xs tracking-[0.25em] uppercase font-sans">Est. 2026 · Dubai</p>
      </div>

      <h1 class="font-serif text-5xl sm:text-6xl lg:text-7xl xl:text-8xl leading-[1.0] text-white mb-8">
        <span class="block overflow-hidden"><span class="block hero-line">Leather.</span></span>
        <span class="block overflow-hidden"><span class="block hero-line text-caramel italic">Handcrafted.</span></span>
        <span class="block overflow-hidden"><span class="block hero-line">Dubai.</span></span>
      </h1>

      <p class="hero-body text-sand/60 text-base sm:text-lg leading-relaxed max-w-lg mb-12 font-light">
        100% Italian cow leather desk accessories made in small batches — designed to age beautifully and grow richer with every use.
      </p>

      <div class="flex flex-wrap gap-4 hero-cta">
        <a
          href="#collection"
          class="inline-flex items-center gap-3 bg-caramel text-white px-8 py-4 text-xs tracking-[0.2em] uppercase hover:bg-caramel-light transition-colors"
        >
          Explore Collection
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25 21 12m0 0-3.75 3.75M21 12H3"/>
          </svg>
        </a>
        <a
          href="#atelier"
          class="inline-flex items-center gap-3 border border-white/20 text-white/70 px-8 py-4 text-xs tracking-[0.2em] uppercase hover:border-white/50 hover:text-white transition-colors"
        >
          Our Story
        </a>
      </div>

      <div class="mt-16 flex flex-wrap gap-8 text-[11px] tracking-[0.2em] uppercase text-sand/30 hero-trust">
        <span>✦ 100% Handmade</span>
        <span>✦ Italian Leather</span>
        <span>✦ Next-Day UAE</span>
        <span>✦ Small Batches</span>
      </div>
    </div>
  </div>

  <div class="absolute bottom-8 right-8 sm:right-12 lg:right-16 xl:right-24 flex flex-col items-center gap-2 z-10">
    <span class="text-[10px] tracking-[0.3em] uppercase text-sand/30 [writing-mode:vertical-lr]">Scroll</span>
    <div class="w-px h-12 bg-gradient-to-b from-sand/30 to-transparent"></div>
  </div>

</section>
