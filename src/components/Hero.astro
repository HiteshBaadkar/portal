---
---
<section class="min-h-[90vh] grid lg:grid-cols-2">

  <!-- Left — Copy -->
  <div class="flex flex-col justify-center px-8 sm:px-12 lg:px-16 xl:px-24 py-20 lg:py-0 order-2 lg:order-1">
    <p class="text-xs tracking-widest uppercase text-caramel mb-6 font-sans">
      Est. 2026 · Dubai Atelier
    </p>
    <h1 class="font-serif text-4xl sm:text-5xl xl:text-6xl leading-[1.1] text-atelier-black mb-8">
      Thoughtfully Designed<br />
      <em class="not-italic text-caramel">&amp; Handcrafted</em><br />
      in Dubai
    </h1>
    <p class="text-atelier-black/60 text-base leading-relaxed max-w-md mb-10 font-sans font-light">
      100% Italian cow leather desk accessories made in small batches — built to age beautifully and grow richer in character with every use.
    </p>
    <div class="flex flex-wrap gap-4">
      <a
        href="#collection"
        class="inline-flex items-center gap-3 bg-atelier-black text-leather-cream px-8 py-4 text-xs tracking-widest uppercase hover:bg-caramel transition-colors"
      >
        Explore the Collection
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25 21 12m0 0-3.75 3.75M21 12H3"/>
        </svg>
      </a>
      <a
        href="#atelier"
        class="inline-flex items-center gap-2 text-xs tracking-widest uppercase text-atelier-black/60 hover:text-caramel transition-colors py-4"
      >
        Our Story
      </a>
    </div>

    <!-- Trust signals -->
    <div class="mt-14 flex flex-wrap gap-6 text-xs text-atelier-black/40 uppercase tracking-wider">
      <span>✦ 100% Handmade</span>
      <span>✦ Italian Leather</span>
      <span>✦ Next-Day Delivery UAE</span>
    </div>
  </div>

  <!-- Right — Hero Image -->
  <div class="relative order-1 lg:order-2 h-[55vw] lg:h-auto min-h-[340px]">
    <img
      src="https://turfaa-atelier.com/cdn/shop/files/9_4dd78e1e-ed58-4786-b3c2-2dc0cdfc4f69.jpg?v=1778655229&width=1920"
      alt="Turfaa Atelier leather desk mat on a premium desk setup"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager"
    />
    <!-- Subtle gradient overlay -->
    <div class="absolute inset-0 bg-gradient-to-r from-leather-cream/30 via-transparent to-transparent lg:hidden"></div>
    <!-- Floating price badge -->
    <div class="absolute bottom-6 left-6 bg-leather-cream/95 backdrop-blur-sm px-4 py-3 shadow-lg">
      <p class="text-xs tracking-widest uppercase text-atelier-black/50 mb-0.5">Starting from</p>
      <p class="font-serif text-xl text-atelier-black">Dhs. 150</p>
    </div>
  </div>

</section>
