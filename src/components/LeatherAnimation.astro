---
---
<section class="bg-void-2 py-28 px-6 sm:px-12 lg:px-16 xl:px-24 overflow-hidden">
  <div class="max-w-7xl mx-auto">

    <div class="flex items-center gap-3 mb-6 anim-up">
      <div class="h-px w-6 bg-caramel"></div>
      <p class="text-caramel text-[11px] tracking-[0.25em] uppercase">Handcrafted</p>
    </div>
    <h2 class="font-serif text-4xl sm:text-5xl text-white mb-16 anim-up">
      From hide to desk,<br /><em class="text-caramel">by hand.</em>
    </h2>

    <!-- Step labels -->
    <div class="flex justify-center gap-2 mb-10" id="step-labels">
      {['Selection', 'Cutting', 'Stitching', 'Finished'].map((label, i) => (
        <div
          id={`step-${i}`}
          class="text-[10px] tracking-[0.2em] uppercase px-4 py-2 border border-white/10 text-sand/30 transition-all duration-500"
        >
          {label}
        </div>
      ))}
    </div>

    <!-- Animation stage -->
    <div class="relative w-full max-w-3xl mx-auto">
      <div class="relative aspect-[16/9] bg-void rounded-sm overflow-hidden">
        <svg id="leather-svg" viewBox="0 0 800 450" class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <filter id="ltex">
              <feTurbulence type="fractalNoise" baseFrequency="0.04" numOctaves="4" seed="2"/>
              <feDisplacementMap in="SourceGraphic" scale="5" xChannelSelector="R" yChannelSelector="G"/>
            </filter>
            <filter id="glow">
              <feGaussianBlur stdDeviation="4" result="b"/>
              <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
            </filter>
            <clipPath id="mat-reveal">
              <rect id="clip-rect" x="180" y="90" width="0" height="270" rx="4"/>
            </clipPath>
          </defs>

          <!-- SCENE 1: Raw leather hide -->
          <g id="g-hide" opacity="0">
            <path
              d="M 110 75 C 160 35 270 25 360 58 C 440 88 510 45 590 88 C 660 128 700 195 678 265 C 655 335 598 385 515 405 C 425 425 330 415 250 392 C 168 368 95 318 85 248 C 72 175 65 115 110 75 Z"
              fill="#7A5530"
              filter="url(#ltex)"
            />
            <!-- Grain lines -->
            <path d="M 190 160 C 290 148 400 168 480 158" fill="none" stroke="#9B6B3E" stroke-width="1.2" opacity="0.5"/>
            <path d="M 155 220 C 270 205 400 225 530 215" fill="none" stroke="#9B6B3E" stroke-width="1.2" opacity="0.5"/>
            <path d="M 170 280 C 290 265 415 282 545 272" fill="none" stroke="#9B6B3E" stroke-width="1.2" opacity="0.5"/>
            <text x="400" y="242" text-anchor="middle" font-family="DM Sans, sans-serif" font-size="10" fill="rgba(251,249,246,0.2)" letter-spacing="5">FULL GRAIN ITALIAN</text>
          </g>

          <!-- SCENE 2: Cutting knife + guide -->
          <g id="g-cut" opacity="0">
            <!-- Keep the hide visible underneath -->
            <path
              d="M 110 75 C 160 35 270 25 360 58 C 440 88 510 45 590 88 C 660 128 700 195 678 265 C 655 335 598 385 515 405 C 425 425 330 415 250 392 C 168 368 95 318 85 248 C 72 175 65 115 110 75 Z"
              fill="#7A5530" opacity="0.5" filter="url(#ltex)"
            />
            <!-- The cutting guide rectangle -->
            <rect id="cut-guide" x="180" y="90" width="440" height="270" rx="4"
              fill="none" stroke="rgba(251,249,246,0.9)" stroke-width="2"
              stroke-dasharray="1500" stroke-dashoffset="1500"
            />
            <!-- Knife icon that travels -->
            <g id="knife" opacity="0">
              <line x1="-12" y1="-12" x2="12" y2="12" stroke="#FBF9F6" stroke-width="2.5" stroke-linecap="round"/>
              <polygon points="0,-14 4,-6 -4,-6" fill="#FBF9F6" transform="rotate(-45)"/>
              <circle cx="0" cy="0" r="6" fill="none" stroke="rgba(140,98,57,0.8)" stroke-width="1.5"/>
            </g>
          </g>

          <!-- SCENE 3 + 4: The actual leather mat (clip reveal) -->
          <g id="g-mat" clip-path="url(#mat-reveal)">
            <rect x="180" y="90" width="440" height="270" rx="4" fill="#8C6239" filter="url(#ltex)"/>
            <rect x="180" y="90" width="440" height="270" rx="4" fill="rgba(0,0,0,0.08)"/>
          </g>

          <!-- SCENE 4: Stitching on top of mat -->
          <g id="g-stitch" opacity="0">
            <rect id="stitch-border" x="198" y="108" width="404" height="234" rx="3"
              fill="none" stroke="rgba(251,249,246,0.8)" stroke-width="1.5"
              stroke-dasharray="7 5" stroke-dashoffset="1500" stroke-linecap="round"
            />
            <text id="mat-word" x="400" y="230" text-anchor="middle"
              font-family="Playfair Display, serif" font-size="20"
              fill="rgba(251,249,246,0)" letter-spacing="7">TURFAA</text>
            <text id="mat-sub" x="400" y="252" text-anchor="middle"
              font-family="DM Sans, sans-serif" font-size="9"
              fill="rgba(251,249,246,0)" letter-spacing="6">ATELIER · DUBAI</text>
          </g>

          <!-- Needle dot -->
          <circle id="needle" cx="198" cy="108" r="5" fill="white" opacity="0" filter="url(#glow)"/>

        </svg>
      </div>

      <p class="text-center text-sand/25 text-xs tracking-widest uppercase mt-6">
        Every piece · Made in Dubai · Italian Leather
      </p>
    </div>

  </div>
</section>

<script>
  import { gsap } from 'gsap';

  function setStep(active: number) {
    [0,1,2,3].forEach(i => {
      const el = document.getElementById(`step-${i}`);
      if (!el) return;
      if (i === active) {
        el.style.borderColor = 'rgba(140,98,57,1)';
        el.style.color = 'rgba(140,98,57,1)';
      } else {
        el.style.borderColor = 'rgba(255,255,255,0.1)';
        el.style.color = 'rgba(154,145,137,0.3)';
      }
    });
  }

  function runLoop() {
    const tl = gsap.timeline({ repeat: -1, repeatDelay: 0.5 });

    // ── SCENE 1: Hide (0–2.5s) ──
    tl.add(() => setStep(0))
      .to('#g-hide', { opacity: 1, scale: 1, transformOrigin: '400px 225px', duration: 0.6, ease: 'power2.out' })
      .to('#g-hide', { opacity: 1, duration: 1.2 })
      .to('#g-hide', { opacity: 0, duration: 0.5, ease: 'power2.in' });

    // ── SCENE 2: Cutting (2.5–5s) ──
    tl.add(() => setStep(1))
      .to('#g-cut', { opacity: 1, duration: 0.4 }, '<')
      .to('#cut-guide', { strokeDashoffset: 0, duration: 1.8, ease: 'power2.inOut' })
      .to('#knife', {
        opacity: 1,
        motionPath: {
          path: [
            { x: 180, y: 90 },
            { x: 620, y: 90 },
            { x: 620, y: 360 },
            { x: 180, y: 360 },
            { x: 180, y: 90 },
          ],
          curviness: 0,
          autoRotate: true,
        },
        duration: 1.8,
        ease: 'power2.inOut',
      }, '<')
      .to('#g-cut', { opacity: 0, duration: 0.5 });

    // ── SCENE 3: Mat wipe reveal (5–6.5s) ──
    tl.add(() => setStep(2))
      .to('#clip-rect', { attr: { width: 440 }, duration: 1.0, ease: 'power3.inOut' }, '<0.2')

    // ── SCENE 4: Stitch (6.5–9s) ──
      .to('#g-stitch', { opacity: 1, duration: 0.3 })
      .to('#stitch-border', { strokeDashoffset: 0, duration: 1.8, ease: 'power2.inOut' })
      .to('#needle', { opacity: 1, duration: 0.2 }, '<')
      .to('#needle', {
        motionPath: {
          path: 'M 198 108 L 602 108 L 602 342 L 198 342 Z',
          autoRotate: false,
        },
        duration: 1.8,
        ease: 'power2.inOut',
      }, '<')
      .add(() => setStep(3))
      .to(['#mat-word', '#mat-sub'], { attr: { fill: 'rgba(251,249,246,0.25)' }, duration: 0.6, stagger: 0.1 })
      .to('#needle', { opacity: 0, duration: 0.3 })
      .to('#g-stitch', { opacity: 0, duration: 0.4 }, '+=0.3')
      .to('#clip-rect', { attr: { width: 0 }, duration: 0.6, ease: 'power2.inOut' }, '<')
      .to(['#mat-word', '#mat-sub'], { attr: { fill: 'rgba(251,249,246,0)' }, duration: 0 }, '<')
      .to('#stitch-border', { strokeDashoffset: 1500, duration: 0 }, '<')
      .to('#cut-guide', { strokeDashoffset: 1500, duration: 0 }, '<');
  }

  // Kick off when section is visible
  const section = document.querySelector('#leather-svg');
  if (section) {
    const observer = new IntersectionObserver(entries => {
      if (entries[0].isIntersecting) {
        runLoop();
        observer.disconnect();
      }
    }, { threshold: 0.3 });
    observer.observe(section);
  }
</script>
