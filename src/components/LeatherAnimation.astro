---
---
<section class="bg-void-2 py-28 px-6 sm:px-12 lg:px-16 xl:px-24 overflow-hidden">
  <div class="max-w-7xl mx-auto">

    <div class="flex items-center gap-3 mb-6 anim-up">
      <div class="h-px w-6 bg-caramel"></div>
      <p class="text-caramel text-[11px] tracking-[0.25em] uppercase">Handcrafted</p>
    </div>
    <h2 class="font-serif text-4xl sm:text-5xl text-white mb-16 anim-up">
      From hide to desk,<br /><em class="text-caramel">by hand.</em>
    </h2>

    <!-- SVG stage -->
    <div class="w-full max-w-3xl mx-auto">
      <div class="aspect-[16/9] bg-void rounded-sm overflow-hidden relative">
        <svg id="la-svg" viewBox="0 0 800 450" class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <filter id="la-tex">
              <feTurbulence type="fractalNoise" baseFrequency="0.045" numOctaves="4" seed="3"/>
              <feDisplacementMap in="SourceGraphic" scale="6" xChannelSelector="R" yChannelSelector="G"/>
            </filter>
            <filter id="la-glow">
              <feGaussianBlur stdDeviation="5" result="b"/>
              <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
            </filter>
            <clipPath id="la-clip">
              <rect id="la-clip-rect" x="180" y="90" width="0" height="270" rx="4"/>
            </clipPath>
          </defs>

          <!-- Hide (scene 1) -->
          <g id="la-hide" opacity="0">
            <path d="M 110 75 C 165 32 275 22 365 56 C 448 88 515 42 595 86 C 668 128 705 198 682 268 C 658 338 600 388 516 408 C 424 428 328 418 246 394 C 162 370 90 320 80 248 C 68 172 62 118 110 75 Z"
              fill="#7A5530" filter="url(#la-tex)"/>
            <path d="M 185 168 C 295 155 415 172 495 162" fill="none" stroke="#9B6B3E" stroke-width="1.2" opacity="0.5"/>
            <path d="M 155 228 C 272 212 412 230 542 220" fill="none" stroke="#9B6B3E" stroke-width="1.2" opacity="0.5"/>
            <path d="M 168 288 C 292 272 420 290 550 280" fill="none" stroke="#9B6B3E" stroke-width="1.2" opacity="0.5"/>
            <text x="400" y="245" text-anchor="middle" font-family="DM Sans,sans-serif" font-size="10" fill="rgba(251,249,246,0.22)" letter-spacing="5">FULL GRAIN ITALIAN</text>
          </g>

          <!-- Cut guide line (scene 2) -->
          <g id="la-cut" opacity="0">
            <path d="M 110 75 C 165 32 275 22 365 56 C 448 88 515 42 595 86 C 668 128 705 198 682 268 C 658 338 600 388 516 408 C 424 428 328 418 246 394 C 162 370 90 320 80 248 C 68 172 62 118 110 75 Z"
              fill="#7A5530" opacity="0.4" filter="url(#la-tex)"/>
            <rect id="la-guide" x="180" y="90" width="440" height="270" rx="4"
              fill="none" stroke="rgba(251,249,246,0.85)" stroke-width="2"
              stroke-dasharray="1500" stroke-dashoffset="1500"/>
            <!-- Knife dot that travels the top edge -->
            <circle id="la-knife" cx="180" cy="90" r="7"
              fill="#FBF9F6" filter="url(#la-glow)" opacity="0"/>
          </g>

          <!-- Mat reveal via clip (scene 3+) -->
          <g clip-path="url(#la-clip)">
            <rect x="180" y="90" width="440" height="270" rx="4" fill="#8C6239" filter="url(#la-tex)"/>
            <rect x="180" y="90" width="440" height="270" rx="4" fill="rgba(0,0,0,0.06)"/>
          </g>

          <!-- Stitch + brand (scene 4) -->
          <g id="la-stitch" opacity="0">
            <rect id="la-stitch-rect" x="198" y="108" width="404" height="234" rx="3"
              fill="none" stroke="rgba(251,249,246,0.8)" stroke-width="1.5"
              stroke-dasharray="7 5" stroke-dashoffset="1500" stroke-linecap="round"/>
            <circle id="la-needle" cx="198" cy="108" r="5"
              fill="white" filter="url(#la-glow)" opacity="0"/>
            <text id="la-brand" x="400" y="232" text-anchor="middle"
              font-family="Playfair Display,serif" font-size="20"
              fill="rgba(251,249,246,0)" letter-spacing="7">TURFAA</text>
            <text id="la-sub" x="400" y="254" text-anchor="middle"
              font-family="DM Sans,sans-serif" font-size="9"
              fill="rgba(251,249,246,0)" letter-spacing="6">ATELIER · DUBAI</text>
          </g>

        </svg>
      </div>
      <p class="text-center text-sand/25 text-xs tracking-widest uppercase mt-6">
        Every piece · Made in Dubai · Italian Leather
      </p>

      <!-- Step labels -->
      <div class="flex justify-center gap-2 mt-8">
        {['Selection', 'Cutting', 'Stitching', 'Finished'].map((label, i) => (
          <div id={`step-${i}`}
            class="text-[10px] tracking-[0.2em] uppercase px-4 py-2 border border-white/10 text-sand/30 transition-all duration-500"
          >{label}</div>
        ))}
      </div>
    </div>

  </div>
</section>

<script>
  import { gsap } from 'gsap';

  const PERIMETER = 1500;

  function activateStep(n: number) {
    for (let i = 0; i < 4; i++) {
      const el = document.getElementById(`step-${i}`);
      if (!el) continue;
      el.style.borderColor = i === n ? '#8C6239' : 'rgba(255,255,255,0.1)';
      el.style.color       = i === n ? '#8C6239' : 'rgba(154,145,137,0.3)';
    }
  }

  function buildTimeline() {
    const tl = gsap.timeline({ repeat: -1 });

    // ── Scene 1: Hide ──────────────────────────────────────────────
    tl.add(() => activateStep(0))
      .to('#la-hide', { opacity: 1, duration: 0.7, ease: 'power2.out' })
      .to('#la-hide', { opacity: 1, duration: 1.5 })           // hold
      .to('#la-hide', { opacity: 0, duration: 0.5 });

    // ── Scene 2: Cutting ───────────────────────────────────────────
    tl.add(() => activateStep(1))
      .to('#la-cut', { opacity: 1, duration: 0.4 }, '<')
      // draw the guide rectangle
      .to('#la-guide', { attr: { strokeDashoffset: 0 }, duration: 2.0, ease: 'power2.inOut' })
      // knife dot travels across the top edge (180→620 x, stays at y=90)
      .to('#la-knife', { opacity: 1, duration: 0.2 }, '<')
      .to('#la-knife', { attr: { cx: 620 }, duration: 0.55, ease: 'none' }, '<')
      .to('#la-knife', { attr: { cy: 360 }, duration: 0.35, ease: 'none' })
      .to('#la-knife', { attr: { cx: 180 }, duration: 0.55, ease: 'none' })
      .to('#la-knife', { attr: { cy: 90 },  duration: 0.35, ease: 'none' })
      .to('#la-knife', { opacity: 0, duration: 0.2 })
      .to('#la-cut',   { opacity: 0, duration: 0.4 });

    // ── Scene 3: Mat wipe ──────────────────────────────────────────
    tl.add(() => activateStep(2))
      .to('#la-clip-rect', { attr: { width: 440 }, duration: 1.0, ease: 'power3.inOut' }, '<0.3');

    // ── Scene 4: Stitching ─────────────────────────────────────────
    tl.add(() => activateStep(3))
      .to('#la-stitch', { opacity: 1, duration: 0.3 })
      .to('#la-stitch-rect', { attr: { strokeDashoffset: 0 }, duration: 2.0, ease: 'power2.inOut' })
      // needle follows corners manually
      .to('#la-needle', { opacity: 1, duration: 0.2 }, '<')
      .to('#la-needle', { attr: { cx: 602 }, duration: 0.5, ease: 'none' }, '<')
      .to('#la-needle', { attr: { cy: 342 }, duration: 0.32, ease: 'none' })
      .to('#la-needle', { attr: { cx: 198 }, duration: 0.5, ease: 'none' })
      .to('#la-needle', { attr: { cy: 108 }, duration: 0.32, ease: 'none' })
      .to('#la-needle', { opacity: 0, duration: 0.2 })
      // brand text appears
      .to(['#la-brand','#la-sub'], { attr: { fill: 'rgba(251,249,246,0.25)' }, duration: 0.6, stagger: 0.15 })
      .to({}, { duration: 1.0 })                               // hold finished state
      // ── Reset for next loop ────────────────────────────────────
      .to(['#la-stitch','#la-hide','#la-cut'], { opacity: 0, duration: 0.5 })
      .to('#la-clip-rect', { attr: { width: 0 }, duration: 0.5, ease: 'power2.inOut' }, '<')
      .set('#la-guide',       { attr: { strokeDashoffset: PERIMETER } })
      .set('#la-stitch-rect', { attr: { strokeDashoffset: PERIMETER } })
      .set('#la-knife',  { attr: { cx: 180, cy: 90 } })
      .set('#la-needle', { attr: { cx: 198, cy: 108 } })
      .set(['#la-brand','#la-sub'], { attr: { fill: 'rgba(251,249,246,0)' } });

    return tl;
  }

  // Start when section scrolls into view
  const svg = document.getElementById('la-svg');
  if (svg) {
    const io = new IntersectionObserver(entries => {
      if (entries[0].isIntersecting) {
        buildTimeline();
        io.disconnect();
      }
    }, { threshold: 0.25 });
    io.observe(svg);
  }
</script>
