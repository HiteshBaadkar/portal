---
<div class="overflow-hidden bg-void border-y border-white/6 py-4 select-none">
  <div class="marquee-track flex gap-0 whitespace-nowrap">
    {Array.from({ length: 2 }).map(() => (
      <div class="marquee-item flex items-center gap-0 shrink-0">
        {[
          'Italian Cow Leather',
          'Hand-Stitched Edges',
          'Made in Dubai',
          'Small Batches Only',
          'Next-Day Delivery',
          'Full-Grain Hide',
          'Italian Cow Leather',
          'Hand-Stitched Edges',
          'Made in Dubai',
          'Small Batches Only',
          'Next-Day Delivery',
          'Full-Grain Hide',
        ].map(text => (
          <span class="flex items-center gap-6 px-6">
            <span class="text-[10px] tracking-[0.28em] uppercase text-sand/35 font-light">{text}</span>
            <span class="text-caramel/40 text-xs">·</span>
          </span>
        ))}
      </div>
    ))}
  </div>
</div>

<style>
  .marquee-track {
    animation: marquee 30s linear infinite;
    will-change: transform;
  }
  @keyframes marquee {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
</style>
