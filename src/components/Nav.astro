---
---
<nav class="sticky top-0 z-40 bg-leather-cream/95 backdrop-blur-sm border-b border-atelier-black/8">
  <div class="max-w-7xl mx-auto px-6 lg:px-12 h-16 flex items-center justify-between">

    <!-- Logo -->
    <a href="/" class="flex-shrink-0">
      <img
        src="https://turfaa-atelier.com/cdn/shop/files/Logo_no_BG_acd6bf0d-850c-451e-9d4e-36166895d033.png?height=100&v=1778488395"
        alt="Turfaa Atelier"
        class="h-9 w-auto"
      />
    </a>

    <!-- Desktop Links -->
    <div class="hidden md:flex items-center gap-8 text-sm tracking-wider uppercase text-atelier-black/70">
      <a href="#collection" class="hover:text-caramel transition-colors">Collection</a>
      <a href="#atelier" class="hover:text-caramel transition-colors">The Atelier</a>
      <a href="#craftsmanship" class="hover:text-caramel transition-colors">Craftsmanship</a>
    </div>

    <!-- CTA -->
    <div class="flex items-center gap-4">
      <a
        href="#collection"
        class="hidden sm:inline-flex items-center gap-2 border border-atelier-black px-5 py-2 text-xs tracking-widest uppercase hover:bg-atelier-black hover:text-leather-cream transition-colors"
      >
        Shop Now
      </a>
      <!-- Hamburger (mobile) -->
      <button id="menu-toggle" class="md:hidden p-2 -mr-2" aria-label="Toggle menu">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-atelier-black/10 bg-leather-cream">
    <div class="px-6 py-4 flex flex-col gap-4 text-sm tracking-wider uppercase text-atelier-black/70">
      <a href="#collection" class="hover:text-caramel transition-colors">Collection</a>
      <a href="#atelier" class="hover:text-caramel transition-colors">The Atelier</a>
      <a href="#craftsmanship" class="hover:text-caramel transition-colors">Craftsmanship</a>
      <a href="https://wa.me/971523244717" target="_blank" rel="noopener noreferrer" class="text-caramel">WhatsApp Us</a>
    </div>
  </div>
</nav>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => menu?.classList.toggle('hidden'));
  document.querySelectorAll('#mobile-menu a').forEach(a => a.addEventListener('click', () => menu?.classList.add('hidden')));
</script>
