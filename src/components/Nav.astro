---
---
<nav class="sticky top-0 z-40 bg-void/90 backdrop-blur-md border-b border-white/5">
  <div class="max-w-7xl mx-auto px-6 lg:px-12 h-20 flex items-center justify-between">

    <a href="/" class="flex-shrink-0 text-white hover:text-sand/80 transition-colors" style="font-family: 'Sacramento', cursive; font-size: 2rem; line-height: 1; letter-spacing: 0.02em;">
      turfaa atelier
    </a>

    <div class="hidden md:flex items-center gap-8 text-[11px] tracking-[0.18em] uppercase text-sand/50">
      <a href="#collection" class="hover:text-caramel transition-colors">Collection</a>
      <a href="#atelier" class="hover:text-caramel transition-colors">The Atelier</a>
      <a href="#craftsmanship" class="hover:text-caramel transition-colors">Craftsmanship</a>
    </div>

    <div class="flex items-center gap-4">
      <a
        href="https://wa.me/971523244717"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex items-center gap-2 bg-caramel text-white px-5 py-2.5 text-[11px] tracking-[0.15em] uppercase hover:bg-caramel-light transition-colors"
      >
        Order Now
      </a>
      <button id="menu-toggle" class="md:hidden p-2 -mr-2 text-sand/60" aria-label="Toggle menu">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5"/>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden md:hidden border-t border-white/5 bg-void-2">
    <div class="px-6 py-5 flex flex-col gap-5 text-[11px] tracking-[0.18em] uppercase text-sand/50">
      <a href="#collection" class="hover:text-caramel transition-colors">Collection</a>
      <a href="#atelier" class="hover:text-caramel transition-colors">The Atelier</a>
      <a href="#craftsmanship" class="hover:text-caramel transition-colors">Craftsmanship</a>
      <a href="https://wa.me/971523244717" target="_blank" rel="noopener noreferrer" class="text-caramel">WhatsApp Us</a>
    </div>
  </div>
</nav>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => menu?.classList.toggle('hidden'));
  document.querySelectorAll('#mobile-menu a').forEach(a => a.addEventListener('click', () => menu?.classList.add('hidden')));
</script>
