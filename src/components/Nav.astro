---
---
<nav class="sticky top-0 z-40 bg-void/90 backdrop-blur-md border-b border-white/5">
  <div class="max-w-7xl mx-auto px-6 lg:px-12 h-20 flex items-center justify-between">

    <a href="/" class="flex-shrink-0 text-white hover:text-sand/80 transition-colors" style="font-family: 'Sacramento', cursive; font-size: 2rem; line-height: 1; letter-spacing: 0.02em;">
      turfaa atelier
    </a>

    <div class="hidden md:flex items-center gap-8 text-xs tracking-[0.18em] uppercase text-sand/50">
      <a href="#collection" class="hover:text-caramel transition-colors">Collection</a>
      <a href="#atelier" class="hover:text-caramel transition-colors">The Atelier</a>
      <a href="#craftsmanship" class="hover:text-caramel transition-colors">Craftsmanship</a>
    </div>

    <div class="flex items-center gap-5">
      <!-- Account -->
      <a
        href="https://turfaa-atelier.com/account/login"
        target="_blank"
        rel="noopener noreferrer"
        class="text-sand/50 hover:text-white transition-colors"
        aria-label="Account"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z"/>
        </svg>
      </a>
      <!-- Cart -->
      <a
        href="https://turfaa-atelier.com/cart"
        target="_blank"
        rel="noopener noreferrer"
        class="text-sand/50 hover:text-white transition-colors"
        aria-label="Cart"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007Z"/>
        </svg>
      </a>
      <a
        href="https://wa.me/971523244717"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex items-center gap-2 bg-caramel text-white px-5 py-2.5 text-xs tracking-[0.15em] uppercase hover:bg-caramel-light transition-colors"
      >
        Order Now
      </a>
      <button id="menu-toggle" class="md:hidden p-2 -mr-2 text-sand/60" aria-label="Toggle menu">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5"/>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden md:hidden border-t border-white/5 bg-void-2">
    <div class="px-6 py-5 flex flex-col gap-5 text-xs tracking-[0.18em] uppercase text-sand/50">
      <a href="#collection" class="hover:text-caramel transition-colors">Collection</a>
      <a href="#atelier" class="hover:text-caramel transition-colors">The Atelier</a>
      <a href="#craftsmanship" class="hover:text-caramel transition-colors">Craftsmanship</a>
      <a href="https://wa.me/971523244717" target="_blank" rel="noopener noreferrer" class="text-caramel">WhatsApp Us</a>
    </div>
  </div>
</nav>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => menu?.classList.toggle('hidden'));
  document.querySelectorAll('#mobile-menu a').forEach(a => a.addEventListener('click', () => menu?.classList.add('hidden')));
</script>
