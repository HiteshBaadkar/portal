---
import Layout from '../layouts/Layout.astro';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import MarqueeStrip from '../components/MarqueeStrip.astro';
import DeskConfigurator from '../components/DeskConfigurator.astro';
import LeatherAnimation from '../components/LeatherAnimation.astro';
import FullBleedImage from '../components/FullBleedImage.astro';
import HeritageSection from '../components/HeritageSection.astro';
import InstagramGrid from '../components/InstagramGrid.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <AnnouncementBar />
  <Nav />
  <main>
    <Hero />
    <MarqueeStrip />
    <DeskConfigurator />
    <LeatherAnimation />
    <FullBleedImage />
    <HeritageSection />
    <InstagramGrid />
    <FAQ />
  </main>
  <Footer />
</Layout>
